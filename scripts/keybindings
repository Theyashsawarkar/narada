# Keys inside the narada screen, for Vayu's keybinding search
# (keybind-search.py reads ~/.tmux/plugins/*/scripts). Generated from
# internal/tui/keys.go by `go test ./internal/tui -update`; don't edit.
# keybind: Tmux/narada | j / k | Move to the next / previous thread or space (j at the end loads older mail)
# keybind: Tmux/narada | + / - | Set how many older mails j at the end loads (10, 25, 50, 100)
# keybind: Tmux/narada | g / G | Jump to the first / last
# keybind: Tmux/narada | h / l | Switch to the previous / next section
# keybind: Tmux/narada | Tab / Shift+Tab | Switch to the next / previous of mail, chat and WhatsApp
# keybind: Tmux/narada | Alt+m / Alt+c / Alt+w | Switch straight to mail / chat / WhatsApp
# keybind: Tmux/narada | 1 / 2 | Focus the list / the preview
# keybind: Tmux/narada | Enter | Open the thread or space (marks it read)
# keybind: Tmux/narada | J / K | Scroll the preview down / up
# keybind: Tmux/narada | E | Toggle every message in the thread open / folded
# keybind: Tmux/narada | Q | Toggle the quoted text in the thread
# keybind: Tmux/narada | o | Open a link from the preview by its number
# keybind: Tmux/narada | Ctrl+d / Ctrl+u | Scroll the preview half a page down / up
# keybind: Tmux/narada | / or s | Open the search window (searches where you are: this section, or this chat)
# keybind: Tmux/narada | W | Save the current search as a section
# keybind: Tmux/narada | X | Remove the current saved-search section
# keybind: Tmux/narada | u | Switch account (all, then each one)
# keybind: Tmux/narada | c | Create a new mail, or a new message in this space (compose)
# keybind: Tmux/narada | r | Send a reply to the thread (in chat: to the picked message, quoting it)
# keybind: Tmux/narada | a | Send a reply to everyone on the thread (reply all)
# keybind: Tmux/narada | f | Send the thread on to someone else (forward)
# keybind: Tmux/narada | e | Move the thread out of the inbox (archive; or every selected one)
# keybind: Tmux/narada | d | Move the thread to the trash (or every selected one)
# keybind: Tmux/narada | m | Set the thread or chat as read (mark read; or every selected one)
# keybind: Tmux/narada | M | Set the thread or chat as unread (mark unread; or every selected one)
# keybind: Tmux/narada | * | Toggle the star on the thread
# keybind: Tmux/narada | L | Add or remove a label (fzf picker)
# keybind: Tmux/narada | x | Select the thread or chat for e / d / m / M (pick several)
# keybind: Tmux/narada | Ctrl+x | Select every thread or chat in the list (again clears)
# keybind: Tmux/narada | Alt+r | Set everything in this list as read (mark all read)
# keybind: Tmux/narada | i | Start typing a chat message right in the preview (Ctrl+t sends it later)
# keybind: Tmux/narada | Enter / 2 (chat) | Pick messages in the chat with j/k (k past the first loads earlier ones)
# keybind: Tmux/narada | Enter (picking) | Jump to the message a reply quotes (again goes further back); on a photo, view it full size
# keybind: Tmux/narada | Space (picking) | Open the picked photo or GIF full size (h/l previous / next, v opens it, Esc back)
# keybind: Tmux/narada | Backspace (picking) | Jump back to the reply you came from
# keybind: Tmux/narada | e (picking) | Toggle a reaction on the picked message (yours are marked ✓; picking one removes it)
# keybind: Tmux/narada | E (picking) | Edit your picked message in the message box
# keybind: Tmux/narada | d d (picking) | Delete your picked message, for everyone
# keybind: Tmux/narada | p | Toggle the chat pinned on top of the list
# keybind: Tmux/narada | [ / ] | Switch to the previous / next chat (staying in the conversation)
# keybind: Tmux/narada | Ctrl+k | Open the chat switcher (search chats, people and messages)
# keybind: Tmux/narada | Ctrl+o (typing) | Add a file to the chat message you're typing
# keybind: Tmux/narada | Ctrl+v (typing) | Paste a copied image (a screenshot) into the chat message as a file
# keybind: Tmux/narada | Enter (typing) | Send the chat message and keep typing the next one (Esc leaves the box)
# keybind: Tmux/narada | Alt+Enter / Ctrl+j (typing) | Start a new line in the chat message
# keybind: Tmux/narada | ←→ Alt+b/f Ctrl+a/e (typing) | Move the cursor in the message by letter, word, line start / end
# keybind: Tmux/narada | ↑↓ (typing) | Move the cursor up / down a line in a long message
# keybind: Tmux/narada | Ctrl+w / Ctrl+k / Ctrl+u (typing) | Delete the word before the cursor / to the end / the whole message
# keybind: Tmux/narada | L (WhatsApp, not linked) | Add this machine to WhatsApp (link it) with a QR code shown in the tab
# keybind: Tmux/narada | P (WhatsApp, not linked) | Add this machine to WhatsApp (link it) with your phone number and a code
# keybind: Tmux/narada | t | Move a scheduled send to another time (in Scheduled; Enter edits it)
# keybind: Tmux/narada | n | Rename the chat (spaces and groups on Google Chat; a DM only here)
# keybind: Tmux/narada | N | Start a conversation (opens the one you have with them, earlier messages and all)
# keybind: Tmux/narada | v | Open the attachments in their apps (kept in ~/Downloads/narada; picker when several)
# keybind: Tmux/narada | V | Save the attachments to ~/Downloads/narada without opening them
# keybind: Tmux/narada | U | Send a file into this chat (Google Chat or WhatsApp; file picker with preview)
# keybind: Tmux/narada | z | Cancel the last change, or a send in its undo window (undo)
# keybind: Tmux/narada | A | Show the sends an agent is waiting on you to approve
# keybind: Tmux/narada | R | Reload mail and chat from Google now (sync)
# keybind: Tmux/narada | b | Open the thread or space in the browser
# keybind: Tmux/narada | y | Copy the link to the thread or space
# keybind: Tmux/narada | @ | Start a question to Claude, with this thread or space as context (ask)
# keybind: Tmux/narada | S | Show Claude's summary of the thread or the space's recent messages
# keybind: Tmux/narada | D | Create a reply draft with Claude, then edit it in your editor
# keybind: Tmux/narada | T | Show today's digest: what came in and what needs you
# keybind: Tmux/narada | ? | Show every key
# keybind: Tmux/narada | q / Esc | Go back, then quit
# keybind: Tmux/narada compose | Tab / Shift+Tab | Move to the next / previous field (Tab adds what you typed first)
# keybind: Tmux/narada compose | Up / Down | Pick a contact from the suggestions
# keybind: Tmux/narada compose | Enter / , | Add the picked contact or typed address, and stay for more
# keybind: Tmux/narada compose | Backspace | Remove the last recipient (in an empty To, Cc or Bcc)
# keybind: Tmux/narada compose | Ctrl+s | Send the mail (after the undo window)
# keybind: Tmux/narada compose | Ctrl+t | Send the mail later (pick or type when: tomorrow 9am, fri 6pm, in 2h)
# keybind: Tmux/narada compose | Ctrl+d | Save the mail as a Gmail draft and close it
# keybind: Tmux/narada compose | Ctrl+o | Add files to the mail (file picker with preview; x removes one in Files)
# keybind: Tmux/narada compose | Ctrl+e | Edit the whole mail in your editor, then come back
# keybind: Tmux/narada compose | Ctrl+q | Toggle the quoted text under a reply or forward
# keybind: Tmux/narada compose | Left / Right | Select a recipient pill (in an empty To, Cc or Bcc; Backspace removes it)
# keybind: Tmux/narada compose | Ctrl+b | Toggle the Cc and Bcc fields
# keybind: Tmux/narada compose | Ctrl+g | Toggle your Gmail signature under the mail
# keybind: Tmux/narada compose | Ctrl+f | Switch the account the mail is sent from
# keybind: Tmux/narada compose | PgUp / PgDn | Scroll the message you're replying to
# keybind: Tmux/narada compose | Esc | Cancel the mail (twice once something is written)
# keybind: Tmux/narada search | Up / Down | Move between the results (Ctrl+p / Ctrl+n too)
# keybind: Tmux/narada search | Enter | Open the result (mail results stay listed as a search section)
# keybind: Tmux/narada search | Tab | Switch where it looks: this section or all mail, this chat or every chat
# keybind: Tmux/narada search | Ctrl+u | Clear the search
# keybind: Tmux/narada search | Esc | Close the search window
# keybind: Tmux/narada review | y | Send the message you wrote (after the undo window)
# keybind: Tmux/narada review | t | Send the message later (pick or type when)
# keybind: Tmux/narada review | e | Edit the message again in your editor
# keybind: Tmux/narada review | + | Add a file to the message (attach; file picker with preview)
# keybind: Tmux/narada review | - | Remove the last file added to the message
# keybind: Tmux/narada review | d | Save the message as a Gmail draft instead of sending
# keybind: Tmux/narada review | n | Delete the message you wrote (discard)
# keybind: Tmux/narada approve | y | Send the message an agent wrote (after the undo window)
# keybind: Tmux/narada approve | e | Edit the agent's message in your editor first
# keybind: Tmux/narada approve | n | Cancel the agent's message (decline; nothing is sent)
# keybind: Tmux/narada approve | q | Leave the agent's message waiting and go back
# keybind: Tmux/narada setup | Tab | Switch to the next path completion (Enter on a folder opens it)
# keybind: Tmux/narada setup | Enter | Save the OAuth client file at this path, or start the Google sign-in
# keybind: Tmux/narada setup | Ctrl+t | Enter the OAuth client ID and secret by hand instead
# keybind: Tmux/narada setup | Ctrl+o | Open the Google Cloud console credentials page
# keybind: Tmux/narada setup | Ctrl+g | Show the steps for creating the OAuth client
# keybind: Tmux/narada setup | Ctrl+d | Start the demo on example mail instead
# keybind: Tmux/narada setup | n | Rename the account before signing in
# keybind: Tmux/narada setup | c | Pick a different OAuth client file
# keybind: Tmux/narada setup | y | Copy the sign-in link
